{
  "uid": "fincaria-resilience",
  "title": "Fincaria — Resilience (cadastral lookup)",
  "tags": ["fincaria"],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Circuit breaker state",
      "description": "Active state of the cadastral registry circuit breaker (1 = active). Watch it move CLOSED -> OPEN under sustained failures, then OPEN -> HALF_OPEN after the wait window.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 25
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "open" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "closed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "half_open" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "resilience4j_circuitbreaker_state{name=\"cadastralRegistry\", state=~\"closed|open|half_open\"}",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Failure rate (%)",
      "description": "Rolling failure rate the circuit breaker sees over its sliding window. -1 (clamped to 0 here) means not enough calls yet to compute it.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(resilience4j_circuitbreaker_failure_rate{name=\"cadastralRegistry\"}, 0)",
          "legendFormat": "failure rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "Calls by outcome (per second)",
      "description": "Rate of calls as seen by the circuit breaker: successful, failed, and short-circuited (not_permitted) while the circuit is open.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "successful" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "not_permitted" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (rate(resilience4j_circuitbreaker_calls_seconds_count{name=\"cadastralRegistry\"}[1m]))",
          "legendFormat": "{{kind}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(resilience4j_circuitbreaker_not_permitted_calls_total{name=\"cadastralRegistry\"}[1m])",
          "legendFormat": "not_permitted"
        }
      ]
    },
    {
      "id": 4,
      "title": "Retry calls by outcome (per second)",
      "description": "Rate of retry outcomes for the cadastral lookup: a logical call may succeed/fail with or without retries.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (rate(resilience4j_retry_calls_total{name=\"cadastralRegistry\"}[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ]
}
